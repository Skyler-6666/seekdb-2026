DROP DATABASE IF EXISTS fts_hotpath;
CREATE DATABASE fts_hotpath;
USE fts_hotpath;
SET NAMES utf8mb4;
SET ob_query_timeout = 10000000000;
SELECT TOKENIZE('Database DATABASE database performance PERFORMANCE', 'beng', '[{"output":"all"}]');
TOKENIZE('Database DATABASE database performance PERFORMANCE', 'beng', '[{"output":"all"}]')
{"tokens": [{"database": 3}, {"performance": 2}], "doc_len": 5}
SELECT TOKENIZE('The THE the and AND with WITH without WITHOUT', 'beng', '[{"output":"all"}]');
TOKENIZE('The THE the and AND with WITH without WITHOUT', 'beng', '[{"output":"all"}]')
{"tokens": [{"without": 2}, {"and": 2}], "doc_len": 4}
SELECT TOKENIZE('OceanBase oceanbase 123 １２３ ABC ＡＢＣ a-b a_b 3.14 ３．１４', 'ik', '[{"output":"all"}]');
TOKENIZE('OceanBase oceanbase 123 １２３ ABC ＡＢＣ a-b a_b 3.14 ３．１４', 'ik', '[{"output":"all"}]')
{"tokens": [{"a-b": 1}, {"123": 1}, {"3.14": 1}, {"a_b": 1}, {"oceanbase": 2}, {"１２３": 1}, {"abc": 1}, {"ａｂｃ": 1}, {"３": 1}, {"１４": 1}], "doc_len": 11}
SELECT TOKENIZE('中华人民共和国人民大会堂 三百二十个 2026年 数据库性能优化', 'ik', '[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]');
TOKENIZE('中华人民共和国人民大会堂 三百二十个 2026年 数据库性能优化', 'ik', '[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]')
{"tokens": [{"个": 1}, {"性能": 1}, {"三百二十": 1}, {"人民大会堂": 1}, {"2026年": 1}, {"优化": 1}, {"数据库": 1}, {"中华人民共和国": 1}], "doc_len": 8}
SELECT TOKENIZE('中华人民共和国人民大会堂 三百二十个 2026年 数据库性能优化', 'ik', '[{"output":"all"},{"additional_args":[{"ik_mode":"max_word"}]}]');
TOKENIZE('中华人民共和国人民大会堂 三百二十个 2026年 数据库性能优化', 'ik', '[{"output":"all"},{"additional_args":[{"ik_mode":"max_word"}]}]')
{"tokens": [{"性能": 1}, {"数据": 1}, {"大会": 1}, {"三百二十": 1}, {"人民大会堂": 1}, {"大会堂": 1}, {"共和国": 1}, {"年": 1}, {"人民大会": 1}, {"人民共和国": 1}, {"中华人民": 1}, {"共和": 1}, {"十个": 1}, {"优化": 1}, {"百二": 1}, {"二十": 1}, {"数据库": 1}, {"会堂": 1}, {"中华": 1}, {"中华人民共和国": 1}, {"2026": 1}, {"国人": 1}, {"华人": 1}, {"库": 1}, {"人民": 2}], "doc_len": 26}
