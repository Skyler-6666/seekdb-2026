--disable_query_log
set @@session.explicit_defaults_for_timestamp=off;
--enable_query_log
#owner: xiaoqiu.wy
#owner group:sql2
#tags: ddl
#description:information schema

connect (obsys1,$OBMYSQL_MS0,admin,$OBMYSQL_PWD,test,$OBMYSQL_PORT);
connection obsys1;

use information_schema;
desc character_sets;
desc collation_character_set_applicability;
desc collations;
desc columns;
desc global_variables;
desc key_column_usage;
desc partitions;
desc processlist;
# Function output types retain the same string/numeric coercibility as table columns.
select coercibility(user_client_ip) as ip_coercibility,
       coercibility(user_client_port) as port_coercibility,
       charset(concat(user_client_ip, ':', user_client_port)) as host_charset
from processlist() where id = connection_id();
desc schema_privileges;
desc schemata;
desc statistics;
desc table_constraints;
desc table_privileges;
desc tables;
desc user_privileges;
desc views;
--source mysql_test/include/show_create_table_old_version.inc
 show create table  character_sets;
