# DESCRIBE binds columns and never starts a scan
DESCRIBE TABLE FUNCTION generator;
signature	column_position	column_name	column_type	description
generator(n)	1	generator	bigint	Integers from 1 to n.
DESCRIBE TABLE FUNCTION unnest;
signature	column_position	column_name	column_type	description
unnest(collection, ...)	NULL	NULL	NULL	Each collection element becomes a row; records supply top-level fields; inputs zip with NULL padding.
DESCRIBE TABLE FUNCTION unnest([1, 2], ['a']) AS t(n);
signature	column_position	column_name	column_type	description
unnest(collection, ...)	1	n	bigint(20)	Each collection element becomes a row; records supply top-level fields; inputs zip with NULL padding.
unnest(collection, ...)	2	unnest_2	varchar(262144)	Each collection element becomes a row; records supply top-level fields; inputs zip with NULL padding.
DESCRIBE TABLE FUNCTION generator(NULL);
signature	column_position	column_name	column_type	description
generator(n)	1	generator	bigint	Integers from 1 to n.
DESCRIBE TABLE FUNCTION JSON_TABLE('[1]', '$[*]' COLUMNS (a INT PATH '$')) AS j(x);
signature	column_position	column_name	column_type	description
json_table(document, path COLUMNS (...))	1	x	int(11)	Columns are declared by COLUMNS.
DESCRIBE TABLE FUNCTION unnest([1], [2]) AS t(x, X);
