# Structured JSON syntax shares aliases, projection and lateral execution
SELECT * FROM JSON_TABLE('[{"x":1},{},{"x":3}]', '$[*]' COLUMNS (
ord FOR ORDINALITY, x INT PATH '$.x' DEFAULT 9 ON EMPTY,
present INT EXISTS PATH '$.x')) AS j;
ord	x	present
1	1	1
2	9	0
3	3	1
SELECT * FROM JSON_TABLE('[{"x":1},{"x":2}]', '$[*]' COLUMNS (
ord FOR ORDINALITY, x INT PATH '$.x')) AS j(position);
position	x
1	1
2	2
SELECT * FROM JSON_TABLE('[{"name":"a","items":[2,3]},{"name":"b","items":[]}]',
'$[*]' COLUMNS (name VARCHAR(10) PATH '$.name',
NESTED PATH '$.items[*]' COLUMNS (item INT PATH '$'))) AS j;
name	item
a	2
a	3
b	NULL
SELECT * FROM JSON_TABLE('[{}, {"x": {}}, {"x": 7}]', '$[*]' COLUMNS (
x INT PATH '$.x' DEFAULT 5 ON EMPTY DEFAULT 6 ON ERROR)) AS j;
x
5
6
7
SELECT COUNT(*) AS rows_seen FROM JSON_TABLE('[1,2,3]', '$[*]' COLUMNS (x INT PATH '$')) AS j;
rows_seen
3
SELECT j.x FROM JSON_TABLE('[{"x":1,"y":2}]', '$[*]' COLUMNS (
x INT PATH '$.x', y INT PATH '$.y')) AS j;
x
1
SELECT * FROM JSON_TABLE('[{}]', '$[*]' COLUMNS (x INT PATH '$.x' ERROR ON EMPTY)) AS j;
