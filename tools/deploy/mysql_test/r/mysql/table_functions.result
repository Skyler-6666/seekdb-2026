# Ordinary functions and table functions use independent namespaces
CREATE FUNCTION memory_info() RETURNS INT RETURN 77;
SELECT memory_info() AS scalar_value;
scalar_value
77
SELECT COUNT(*) >= 0 AS table_function_ran FROM memory_info();
table_function_ran
1
DROP FUNCTION memory_info;
# Query expansion binds structure without evaluating user functions
CREATE TABLE tf_hybrid(id INT, n INT);
INSERT INTO tf_hybrid SELECT id, n FROM tf_inputs;
SELECT * FROM hybrid_search('tf_hybrid', '{"_source":["id","n"],"size":10}') AS h
ORDER BY h.id;
id	n	_score
1	2	1
2	0	1
3	1	1
4	3	1
SELECT * FROM hybrid_search(CONCAT('tf_', 'hybrid'),
CONCAT('{"_source":["id",', '"n"],"size":10}')) AS h(first) ORDER BY h.first;
first	n	_score
1	2	1
2	0	1
3	1	1
4	3	1
PREPARE tf_hybrid_fixed FROM 'SELECT * FROM hybrid_search(CONCAT(''tf_'', ''hybrid''), ''{"_source":["id"],"size":10}'') AS h ORDER BY h.id';
EXECUTE tf_hybrid_fixed;
id	_score
1	1
2	1
3	1
4	1
INSERT INTO tf_hybrid VALUES (5, 9);
EXECUTE tf_hybrid_fixed;
id	_score
1	1
2	1
3	1
4	1
5	1
DELETE FROM tf_hybrid WHERE id = 5;
DEALLOCATE PREPARE tf_hybrid_fixed;
SET @tf_config = '{"_source":["id"],"size":10}';
SELECT * FROM hybrid_search('tf_hybrid', @tf_config) AS h ORDER BY 1;
id	_score
1	1
2	1
3	1
4	1
SET @tf_config = '{"_source":["n"],"size":10}';
SELECT * FROM hybrid_search('tf_hybrid', @tf_config) AS h ORDER BY 1;
n	_score
0	1
1	1
2	1
3	1
PREPARE tf_hybrid FROM 'SELECT * FROM hybrid_search(?, ''{}'') AS h';
ERROR 0A000: nonconstant binding parameters in table functions not supported
PREPARE tf_hybrid FROM 'SELECT * FROM hybrid_search(''tf_hybrid'', @tf_config) AS h';
ERROR 0A000: mutable binding parameters in prepared table functions not supported
CREATE FUNCTION tf_binding_probe() RETURNS VARCHAR(20) DETERMINISTIC
RETURN (@tf_side_effect := @tf_side_effect + 1);
SET @tf_side_effect = 0;
DESCRIBE TABLE FUNCTION hybrid_search('tf_hybrid', tf_binding_probe());
ERROR 0A000: nonconstant binding parameters in table functions not supported
SELECT @tf_side_effect AS calls_during_binding;
calls_during_binding
0
DROP FUNCTION tf_binding_probe;
DROP TABLE tf_inputs, tf_hybrid;
